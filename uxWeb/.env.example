# Copy to .env for local development, and set the same values in the Vercel
# project's environment variables for preview + production.
#
# .env is gitignored — never commit real values.

# Postgres connection string (already provisioned via Vercel storage).
POSTGRES_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Vercel Blob store, for event image uploads.
# Created automatically when you attach a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# bcrypt hash of the shared admin password.
# Generate with: node -e "import('bcryptjs').then(b=>b.default.hash(process.argv[1],12)).then(console.log)" "your-password"
#
# MUST be single-quoted. `vercel dev` expands $VAR in .env, and a bcrypt hash is
# full of $ ($2b$12$...). Double quotes silently mangle it and every login fails
# with "Incorrect password".
ADMIN_PASSWORD_HASH='$2b$12$...'

# Random secret used to sign admin session JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="..."
